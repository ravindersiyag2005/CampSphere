# ─── Environment files ───────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Node / npm ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Uploads (user-generated files — keep the placeholder only) ──────────────
backend/uploads/*
!backend/uploads/.gitkeep

